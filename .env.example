# Shared variable catalog for the project.
# Copy values into the appropriate runtime:
# - local development: .env.local
# - Vercel preprod project: project environment variables
# - Vercel prod project: project environment variables
#
# Public values exposed in the Vite bundle must start with VITE_.
# Private values must never use the VITE_ prefix.

# Application
VITE_APP_ENV=local
VITE_APP_NAME=Bougnat Darts
VITE_APP_VERSION=dev
VITE_APP_URL=http://localhost:3000

# Supabase public client configuration
# Local values are generated by Supabase CLI. Retrieve them with:
#   npx supabase status
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-or-remote-anon-key

# Optional frontend flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_BETA_BADGE=false
VITE_LOG_LEVEL=info

# Private server/admin values
# Never expose these in frontend code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_PROJECT_ID=replace-with-project-ref

# OAuth is primarily configured in Supabase Auth per environment.
# Keep the frontend limited to public runtime URLs when possible.
GOOGLE_OAUTH_CLIENT_ID=replace-only-if-needed-outside-supabase
GOOGLE_OAUTH_CLIENT_SECRET=never-commit-real-secret

# Observability (optional)
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
