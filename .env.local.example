# Local development example for WSL + Vite + Supabase CLI
#
# 1. Copy this file to .env.local
# 2. Start the local stack:
#      npm run supabase:start
# 3. Read the generated local values:
#      npx supabase status
# 4. Replace the placeholders below with the actual generated values
#
# Do not commit .env.local.

VITE_APP_ENV=local
VITE_APP_NAME=Bougnat Darts
VITE_APP_VERSION=dev
VITE_APP_URL=http://localhost:3000

# Generated by Supabase CLI local stack
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-anon-key-from-supabase-status

# Optional local-only toggles
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_BETA_BADGE=true
VITE_LOG_LEVEL=debug
