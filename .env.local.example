# Local development example for WSL + Vite
#
# 1. Copy this file to .env.local
# 2. Start the app:
#      npm run dev
#
# Do not commit .env.local.

VITE_APP_ENV=local
VITE_APP_NAME=Bougnat Darts Counter
VITE_APP_VERSION=2.0.0-dev
VITE_APP_URL=http://localhost:3000
VITE_APP_ACCESS_MODE=local
VITE_TOURNAMENT_API_BASE_URL=http://localhost:8080
VITE_CLERK_FRONTEND_API_URL=https://living-molly-13.clerk.accounts.dev
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_JWT_TEMPLATE_NAME=bougnat-darts-api
VITE_CF_WEB_ANALYTICS_TOKEN=

# Optional local-only toggles
DEEPGRAM_API_KEY=

VITE_ENABLE_BETA_BADGE=true
VITE_ENABLE_VOICE_SCORING=false
VITE_LOG_LEVEL=debug
