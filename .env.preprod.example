# Preproduction example for the dedicated Vercel preprod project.
#
# Usage:
# 1. Copy this file to .env.preprod if you want to validate values locally.
# 2. Set the same values in the Vercel preprod project environment variables.
# 3. Run: npm run preprod:check
#
# Do not commit .env.preprod.

VITE_APP_ENV=preprod
VITE_APP_NAME=Bougnat Darts
VITE_APP_VERSION=git-sha-or-release-id
VITE_APP_URL=https://preprod.bougnat-darts.example

# Supabase preprod public client
VITE_SUPABASE_URL=https://your-preprod-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-preprod-anon-key

# Optional frontend flags for the preprod app
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_BETA_BADGE=true
VITE_LOG_LEVEL=info

# Optional helper values for manual checks / scripts
SUPABASE_PROJECT_ID=replace-with-preprod-project-ref
