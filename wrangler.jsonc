{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "bougnat-darts-counter",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-05-19",

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
